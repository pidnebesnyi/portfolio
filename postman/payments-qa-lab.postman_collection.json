    {
      "name": "AUTH-LOGIN",
      "description": "Requirement #40: login with a password, and a second factor for admins.",
      "item": [
        {
          "name": "Admin login, step 1: password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('second factor required, no access token yet', () => {",
                  "    pm.expect(body.mfa_required).to.eql(true);",
                  "    pm.expect(body).to.not.have.property('access_token');",
                  "});",
                  "pm.collectionVariables.set('mfaToken', body.mfa_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "An admin gets an MFA token, not an access token."
          }
        },
        {
          "name": "Admin login, step 2: one-time code",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RFC 6238 code (SHA-1, 30 s, 6 digits) from the admin's TOTP secret, so the run needs no",
                  "// authenticator app. Same algorithm as load/locustfile.py.",
                  "const cryptoJs = require('crypto-js');",
                  "const secret = pm.variables.get('adminTotpSecret');",
                  "if (!secret) { throw new Error('adminTotpSecret is empty: set it in the environment (value from .env)'); }",
                  "const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "let bits = '';",
                  "for (const c of secret.replace(/=+$/, '').toUpperCase()) {",
                  "    const v = alphabet.indexOf(c);",
                  "    if (v < 0) { throw new Error('adminTotpSecret is not base32'); }",
                  "    bits += v.toString(2).padStart(5, '0');",
                  "}",
                  "let keyHex = '';",
                  "for (let i = 0; i + 8 <= bits.length; i += 8) {",
                  "    keyHex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "}",
                  "const counterHex = Math.floor(Date.now() / 30000).toString(16).padStart(16, '0');",
                  "const mac = cryptoJs.HmacSHA1(cryptoJs.enc.Hex.parse(counterHex), cryptoJs.enc.Hex.parse(keyHex)).toString();",
                  "const offset = parseInt(mac.slice(-1), 16);",
                  "const code = (parseInt(mac.substr(offset * 2, 8), 16) & 0x7fffffff) % 1000000;",
                  "pm.variables.set('totpCode', String(code).padStart(6, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('bearer token', () => pm.expect(body.token_type).to.eql('bearer'));",
                  "pm.collectionVariables.set('adminToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/2fa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_token\": \"{{mfaToken}}\",\n  \"code\": \"{{totpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The pre-request script computes the code from `adminTotpSecret`."
          }
        },
        {
          "name": "Wrong password is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code invalid_credentials', () => pm.expect(pm.response.json().code).to.eql('invalid_credentials'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
