# Copy with `scripts/make_env.sh` (generates random values) or by hand. Placeholders only.
# .env is git-ignored; never commit real values.

# Signs JWTs. At least 32 characters.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# The app creates/updates this admin at startup. The tests log in with the same values.
ADMIN_EMAIL=admin@lab.test
ADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-16
# Base32, at least 16 characters, e.g. `python3 -c "import pyotp; print(pyotp.random_base32())"`.
ADMIN_TOTP_SECRET=change-me-base32-secret
# Password of the Postgres container started by docker compose.
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-16
# Password of the RabbitMQ container's `lab` user (compose builds the broker URL from it).
RABBITMQ_PASSWORD=change-me-generate-with-openssl-rand-hex-16

# Environment under test: local (default), ci, staging or production. Anything else stops the run.
# staging and production are read-only: tests that change data are skipped and the HTTP client
# refuses to send anything but GET/HEAD/OPTIONS and the login POSTs. Read-only smoke run:
#   TARGET_ENV=staging pytest -m "smoke and not destructive"
# TARGET_ENV=local

# --- Only for running without Docker (uvicorn + your own Postgres) -------------------------
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/payments
# DB_DSN=postgresql://postgres:<password>@localhost:5432/payments
# BASE_URL=http://localhost:8000
# The provider stub (WireMock, see README): java -jar wiremock-standalone-3.13.2.jar --port 8081 --root-dir provider-mock
# PROVIDER_URL=http://localhost:8081
# Optional, for log and event checks without Docker. The app appends its JSON request log to
# LOG_FILE and publishes domain events to RABBITMQ_URL; the tests read APP_LOG_FILE (the same file)
# and consume from the same broker. Left empty, the tests/logs and tests/events tests skip.
# LOG_FILE=/tmp/payments-lab-app.log
# APP_LOG_FILE=/tmp/payments-lab-app.log
# RABBITMQ_URL=amqp://lab:<password>@localhost:5672/
